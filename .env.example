# VK
VK_BOT_TOKEN=
VK_GROUP_ID=
VK_ADMIN_IDS=
# User token админа (groups, photos, wall) — для scripts/setup_vk_community.py
VK_USER_TOKEN=

# AI — две разные модели:
# GROK_MODEL — текст (планировка, описания). НЕ image-модель!
# GROK_IMAGE_MODEL — генерация интерьеров (Imagine)
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning
GROK_IMAGE_MODEL=grok-imagine-image-2026-03-02
# Если 404 на image API — попробуйте grok-imagine-image или grok-imagine-image-quality
# GROK_IMAGE_API_URL=https://api.x.ai/v1/images/generations
GROK_API_URL=https://api.x.ai/v1/chat/completions

# ЮKassa (тестовый режим: secret_key с префиксом test_ из кабинета)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=1

# DB
DATABASE_URL=
# без DATABASE_URL — SQLite planirovka.db
